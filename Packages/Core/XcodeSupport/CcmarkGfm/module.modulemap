// Xcode 构建用的 clang module map。
//
// 为什么需要这个文件：SwiftPM 会为每个 C target 自动生成 module map，但 Xcode 的
// 原生 target 不会——不提供它，`import CcmarkGfm` 在 Xcode 里就编不过。
//
// 为什么放在 Sources/ 之外：SwiftPM 只认 `Sources/<Target>` 下的文件，放这里
// 不会被包管理器当作源码或资源，两条构建链路互不干扰。
//
// 为什么列三个头而不是只列 cmark-gfm.h：MarkdownRenderer 用到的
// `cmark_gfm_core_extensions_ensure_registered` / `cmark_find_syntax_extension` /
// `cmark_parser_attach_syntax_extension` 分别在下面两个头里，umbrella 头并不包含它们。
module CcmarkGfm {
    header "../../Sources/CcmarkGfm/include/cmark-gfm.h"
    header "../../Sources/CcmarkGfm/include/cmark-gfm-core-extensions.h"
    header "../../Sources/CcmarkGfm/include/cmark-gfm-extension_api.h"
    export *
}
